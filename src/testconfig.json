{
  "codeCoverage": {
    "Configuration": {
      "Format": "cobertura",
      "CodeCoverage": {
        "SkipAutoProperties": false,
        "Attributes": {
          "Exclude": ["^System\\.CodeDom\\.Compiler\\.GeneratedCodeAttribute$"]
        },
        "Sources": {
          "Exclude": ["[/\\\\]obj[/\\\\].*\\.g\\.cs$"]
        },
        "Functions": {
          "Exclude": [".*__.*"]
        },
        "ModulePaths": {
          "Include": ["ReactiveMvvm\\.dll$"],
          "Exclude": [".*Tests\\.dll$", ".*TestRunner.*"]
        }
      }
    }
  }
}
